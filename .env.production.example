# ==========================================
# OpenShorts Production Environment Settings
# ==========================================

# 1. Reverse Proxy & Domain Settings
# Replace with your free dynamic DNS or sslip domain (e.g. openshorts-api.duckdns.org or 123.45.67.89.sslip.io)
DOMAIN=localhost

# 2. CORS: Allowed Frontend Origins (Comma separated)
# Include your Cloudflare Pages production URL and localhost for local testing
ALLOWED_ORIGINS=https://openshorts.pages.dev,http://localhost:5173,http://localhost:5175

# 3. Model & AI Keys (Bring Your Own Key - Self Host Mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL_THUMBNAIL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# 4. Pipeline & Transcriber Settings (Optimized for Free CPU VMs)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
TRANSCRIBE_BACKEND=whisper
FFMPEG_ENCODER=x264
QUALITY_GATE_MIN_HEIGHT=720

# 5. Service Routing (Internal Docker Network)
RENDER_SERVICE_URL=http://renderer:3100
OUTPUT_DIR=/app/output
UPLOAD_DIR=/app/uploads

# 6. Optional Social & Storage Integrations
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=
